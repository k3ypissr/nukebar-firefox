content hackbar chrome/content/
overlay chrome://browser/content/browser.xul chrome://hackbar/content/hackbar.xul
locale hackbar en-US chrome/locale/en-US/
skin hackbar classic/1.0 chrome/skin/win/ os=WINNT
skin hackbar classic/1.0 chrome/skin/lin/ os=Linux
skin hackbar classic/1.0 chrome/skin/lin/ os=NetBSD
skin hackbar classic/1.0 chrome/skin/lin/ os=OpenBSD
skin hackbar classic/1.0 chrome/skin/lin/ os=SunOS

# LiveHTTPHeaders / Tamper Data / NoRedirect shipped as JARs in the v2.9 XPI.
# Register their packages (no overlays: their browser UI is not wanted here).
content livehttpheaders jar:chrome/livehttpheaders.jar!/content/
skin livehttpheaders classic/1.0 jar:chrome/livehttpheaders.jar!/skin/
locale livehttpheaders en-US jar:chrome/livehttpheaders.jar!/locale/en-US/livehttpheaders/

content tamperdata jar:chrome/tamperdata.jar!/content/
locale tamperdata en jar:chrome/tamperdata.jar!/locale/en/
locale tamperdata en-US jar:chrome/tamperdata.jar!/locale/en-US/

content noredirect jar:chrome/noredirect.jar!/content/
locale noredirect en-US jar:chrome/noredirect.jar!/locale/en-US/

